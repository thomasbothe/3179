{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "title": "Life Expectancy, 2000-2024",
  "width": "container",
  "height": 300,
  "view": {
    "stroke": null
  },
  "params": [
    {
      "name": "Country_selection",
      "value": "Australia",
      "bind": {
        "input": "select",
        "options": [
          "Afghanistan",
          "Australia",
          "Bolivia",
          "Brazil",
          "Burundi",
          "Canada",
          "Chile",
          "China",
          "Guyana",
          "Haiti",
          "India",
          "Japan",
          "Moldova",
          "Monaco",
          "Nauru",
          "New Zealand",
          "Nicaragua",
          "Nigeria",
          "Seychelles",
          "Singapore",
          "United Kingdom",
          "United States"
        ],
        "name": "Country: "
      }
    },
    {
      "name": "Highlight_continent",
      "value": false,
      "bind": {
        "input": "checkbox",
        "name": "Highlight whole continent: "
      }
    },
    {
      "name": "Continent_of",
      "value": {
        "Afghanistan": "Asia",
        "Australia": "Oceania",
        "Bolivia": "South America",
        "Brazil": "South America",
        "Burundi": "Africa",
        "Canada": "North America",
        "Chile": "South America",
        "China": "Asia",
        "Guyana": "South America",
        "Haiti": "North America",
        "India": "Asia",
        "Japan": "Asia",
        "Moldova": "Europe",
        "Monaco": "Europe",
        "Nauru": "Oceania",
        "New Zealand": "Oceania",
        "Nicaragua": "North America",
        "Nigeria": "Africa",
        "Seychelles": "Africa",
        "Singapore": "Asia",
        "United Kingdom": "Europe",
        "United States": "North America"
      }
    },
    {
      "name": "Continent_selected",
      "expr": "Continent_of[Country_selection]"
    }
  ],
  "data": {
    "url": "Life_Exp.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "indexof([\"Afghanistan\", \"Australia\", \"Bolivia\", \"Brazil\", \"Burundi\", \"Canada\", \"Chile\", \"China\", \"Guyana\", \"Haiti\", \"India\", \"Japan\", \"Moldova\", \"Monaco\", \"Nauru\", \"New Zealand\", \"Nicaragua\", \"Nigeria\", \"Seychelles\", \"Singapore\", \"United Kingdom\", \"United States\"], datum['Country Name']) >= 0"
    },
    {
      "fold": [
        "2000",
        "2001",
        "2002",
        "2003",
        "2004",
        "2005",
        "2006",
        "2007",
        "2008",
        "2009",
        "2010",
        "2011",
        "2012",
        "2013",
        "2014",
        "2015",
        "2016",
        "2017",
        "2018",
        "2019",
        "2020",
        "2021",
        "2022",
        "2023",
        "2024"
      ],
      "as": [
        "Year",
        "LifeExpectancy"
      ]
    },
    {
      "calculate": "toNumber(datum.Year)",
      "as": "YearNumber"
    },
    {
      "calculate": "toNumber(datum.LifeExpectancy)",
      "as": "LifeExpectancyNumber"
    },
    {
      "filter": "isValid(datum.LifeExpectancyNumber) && isFinite(datum.LifeExpectancyNumber)"
    },
    {
      "calculate": "Continent_of[datum['Country Name']]",
      "as": "Continent"
    },
    {
      "calculate": "Highlight_continent ? datum.Continent === Continent_selected : datum['Country Name'] === Country_selection",
      "as": "highlighted"
    }
  ],
  "encoding": {
    "x": {
      "field": "YearNumber",
      "type": "quantitative",
      "title": "Year",
      "scale": {
        "domain": [
          2000,
          2024
        ]
      },
      "axis": {
        "format": "d",
        "tickMinStep": 2
      }
    },
    "y": {
      "field": "LifeExpectancyNumber",
      "type": "quantitative",
      "title": "Life expectancy (years)",
      "scale": {
        "zero": false
      }
    },
    "tooltip": [
      {
        "field": "Country Name",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "Continent",
        "type": "nominal"
      },
      {
        "field": "YearNumber",
        "type": "quantitative",
        "title": "Year",
        "format": "d"
      },
      {
        "field": "LifeExpectancyNumber",
        "type": "quantitative",
        "title": "Life expectancy",
        "format": ".1f"
      }
    ],
    "color": {
      "field": "Country Name",
      "type": "nominal",
      "scale": {
        "domain": [
          "Afghanistan",
          "Australia",
          "Bolivia",
          "Brazil",
          "Burundi",
          "Canada",
          "Chile",
          "China",
          "Guyana",
          "Haiti",
          "India",
          "Japan",
          "Moldova",
          "Monaco",
          "Nauru",
          "New Zealand",
          "Nicaragua",
          "Nigeria",
          "Seychelles",
          "Singapore",
          "United Kingdom",
          "United States"
        ],
        "range": [
          "#e41a1c",
          "#377eb8",
          "#a65628",
          "#a65628",
          "#984ea3",
          "#a6cee3",
          "#a65628",
          "#e41a1c",
          "#a65628",
          "#a6cee3",
          "#e41a1c",
          "#e41a1c",
          "#ff7f00",
          "#ff7f00",
          "#377eb8",
          "#377eb8",
          "#a6cee3",
          "#984ea3",
          "#984ea3",
          "#e41a1c",
          "#ff7f00",
          "#a6cee3"
        ]
      },
      "legend": null
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "!datum.highlighted"
        }
      ],
      "mark": {
        "type": "line"
      },
      "encoding": {
        "detail": {
          "field": "Country Name",
          "type": "nominal"
        },
        "order": {
          "field": "YearNumber",
          "type": "quantitative"
        },
        "color": {
          "value": "#999999"
        },
        "opacity": {
          "value": 0.35
        },
        "size": {
          "value": 1
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.highlighted"
        }
      ],
      "mark": {
        "type": "line"
      },
      "encoding": {
        "detail": {
          "field": "Country Name",
          "type": "nominal"
        },
        "order": {
          "field": "YearNumber",
          "type": "quantitative"
        },
        "size": {
          "condition": {
            "test": "datum['Country Name'] === Country_selection",
            "value": 3
          },
          "value": 2
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.highlighted"
        }
      ],
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 60,
        "opacity": 1
      },
      "encoding": {}
    },
    {
      "description": "COVID-19 band 2020-2021",
      "data": {
        "values": [
          {
            "start": 2020,
            "end": 2021
          }
        ]
      },
      "mark": {
        "type": "rect",
        "opacity": 0.12
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "quantitative"
        },
        "x2": {
          "field": "end"
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": "height"
        },
        "tooltip": null,
        "color": {
          "value": "#666666"
        }
      }
    },
    {
      "description": "COVID-19 label",
      "data": {
        "values": [
          {
            "x": 2020.5
          }
        ]
      },
      "mark": {
        "type": "text",
        "text": "COVID-19",
        "align": "center",
        "baseline": "top",
        "dy": 4,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#555555"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "value": 0
        },
        "tooltip": null,
        "color": {
          "value": "#555555"
        }
      }
    },
    {
      "description": "Haiti 2010 marker",
      "transform": [
        {
          "filter": "datum['Country Name'] === 'Haiti' && datum.YearNumber === 2010"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "size": 160,
        "strokeWidth": 2
      },
      "encoding": {
        "tooltip": null,
        "color": {
          "value": "#333333"
        }
      }
    },
    {
      "description": "Haiti 2010 label",
      "transform": [
        {
          "filter": "datum['Country Name'] === 'Haiti' && datum.YearNumber === 2010"
        }
      ],
      "mark": {
        "type": "text",
        "text": "Haiti earthquake, 2010",
        "align": "left",
        "baseline": "middle",
        "dx": 14,
        "dy": -6,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "tooltip": null,
        "color": {
          "value": "#333333"
        }
      }
    }
  ]
}


