{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "view": {
    "stroke": null
  },
  "title": "Where Are Australia's Hospitals?",
  "width": 700,
  "height": 420,
  "projection": {
    "type": "mercator",
    "center": [134, -28],
    "scale": 550,
    "translate": [350, 220]
  },
  "layer": [
    {
      "data": {
        "url": "ne_110m.json",
        "format": { "type": "topojson", "feature": "ne_110m_admin_0_countries" }
      },
        "transform": [
        { "filter": "datum.properties.ADMIN === 'Australia'" }
      ],
      "mark": { "type": "geoshape", "fill": "lightgray", "stroke": "white"}
    },
    {
      "data": { "url": "hospitals.csv" },
      "mark": { "type": "circle", "size": 18, "opacity": 0.6 },
      "encoding": {
        "longitude": { "field": "Longitude", "type": "quantitative" },
        "latitude": { "field": "Latitude", "type": "quantitative" },
        "tooltip": [
          { "field": "Name", "type": "nominal", "title": "Hospital" },
          { "field": "State", "type": "nominal", "title": "State/Territory" }
        ]
      }
    }
  ]
}