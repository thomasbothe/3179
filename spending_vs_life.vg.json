{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "title": "Spending vs life expectancy (2023)",
  "width": "container",
  "height": 380,
  "data": {
    "url": "expectancy_expenditure.csv"
  },
  "encoding": {
    "x": {
      "field": "2023 Life Expectancy",
      "type": "quantitative",
      "title": "Life Expectancy (years)",
      "scale": {
        "domain": [
          50,
          90
        ]
      }
    },
    "y": {
      "field": "2023 GDP",
      "type": "quantitative",
      "title": "Healthcare Spending as % of GDP"
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "continent_highlight",
          "select": {
            "type": "point",
            "fields": [
              "Continent"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 80
      },
      "encoding": {
        "color": {
          "field": "Continent",
          "type": "nominal",
          "title": "Continent: Click continent to filter",
          "scale": {
            "domain": [
              "Asia",
              "Africa",
              "Europe",
              "North America",
              "Oceania",
              "South America"
            ],
            "range": [
              "#e41a1c",
              "#984ea3",
              "#ff7f00",
              "#a6cee3",
              "#377eb8",
              "#a65628"
            ]
          }
        },
        "tooltip": [
          {
            "field": "Country Name",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Continent",
            "type": "nominal"
          },
          {
            "field": "2023 GDP",
            "type": "quantitative",
            "title": "Healthcare Spending as % of GDP",
            "format": ".1f"
          },
          {
            "field": "2023 Life Expectancy",
            "type": "quantitative",
            "title": "Life Expectancy (years)",
            "format": ".1f"
          }
        ],
        "opacity": {
          "condition": {
            "param": "continent_highlight",
            "value": 0.6
          },
          "value": 0.2
        }
      }
    },
    {
      "description": "Country name labels",
      "transform": [
        {
          "filter": "datum['Country Name'] === 'Japan' || datum['Country Name'] === 'Tuvalu' || datum['Country Name'] === 'United States of America'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 9,
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "text": {
          "field": "Country Name",
          "type": "nominal"
        }
      }
    }
  ]
}


