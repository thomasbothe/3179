{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "view": {"stroke": null},
  "title": "Life Expectancy",
  "width": 520,
  "height": 300,
  "params": [
    {
        "name": "Year_selection",
        "value": 2015,
        "bind": {
            "input": "range",
            "min": 2015,
            "max": 2024,
            "step": 1,
            "name": "Year: "
        }
    },
    {
        "name": "zoom_level",
        "value": 100,
        "bind": {
            "input": "range",
            "min": 100,
            "max": 500,
            "step": 100,
            "name": "Zoom: "
        }
    },
    {
        "name": "centre_to",
        "value": [0, 0],
        "bind": {
            "input": "select",
            "options": [
                [0, 0],
                [100, 30],
                [20, 0],
                [15, 52],
                [-100, 40],
                [-60, -15],
                [175, -15]
            ],
            "labels": ["World", "Asia", "Africa", "Europe", "North America", "South America", "Oceania"],
            "name": "Map Centre: "
        }
    }
  ],
  "projection": {
    "type": "equalEarth",
    "center": {"expr": "centre_to"},
    "scale": {"expr": "zoom_level"}
  },
  "layer": [
    {
      "data": {
        "url": "ne_110m.json",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d3d3d3",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "ne_110m.json",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "lookup": "properties.NAME_EN",
          "from": {
            "data": {
              "url": "Life_Expect_Data.csv"
            },
            "key": "Country Name",
            "fields": [
              "2015",
              "2016",
              "2017",
              "2018",
              "2019",
              "2020",
              "2021",
              "2022",
              "2023",
              "2024"
            ]
          }
        },
        {
            "fold": [
                "2015",
                "2016",
                "2017",
                "2018",
                "2019",
                "2020",
                "2021",
                "2022",
                "2023",
                "2024"               
            ],
            "as": ["Year", "LifeExpectancy"]
        },
        {
            "filter": "toNumber(datum.Year) === Year_selection"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white"
      },
      "encoding": {
        "color": {
          "field": "LifeExpectancy",
          "type": "quantitative",
          "title": "Age (years)",
          "scale": {
            "scheme": "blues",
            "domain": [40, 85],
            "clamp": true
          }
        },
        "tooltip": [
          {
            "field": "properties.NAME_EN",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "LifeExpectancy",
            "type": "quantitative",
            "title": "Age (years)",
            "format": ".1f"
          },
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year"
          }
        ]
      }
    }
  ]
}