{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "view": {
    "stroke": null
  },
  "title": "Percentage Vaccinated Against Measles",
  "width": 700,
  "height": 420,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "ne_110m.json",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d3d3d3",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "ne_110m.json",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "lookup": "properties.ADMIN",
          "from": {
            "data": {
              "url": "Measles_Data.csv"
            },
            "key": "Reference area",
            "fields": ["OBS_VALUE", "TIME_PERIOD"]
          }
        },
        {
          "filter": "isValid(datum.OBS_VALUE)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "tooltip": true
      },
      "encoding": {
        "color": {
          "field": "OBS_VALUE",
          "type": "quantitative",
          "title": "Percentage Vaccinated (%)",
          "scale": {
            "scheme": "blues"
          }
        },
        "tooltip": [
          {
            "field": "properties.ADMIN",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "OBS_VALUE",
            "type": "quantitative",
            "title": "Percentage Vaccinated (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ]
}