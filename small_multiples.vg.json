{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json", 
  "background": "transparent",
  "title": "Australia (red) against the other countries",
  "data": {"url": "health_joined.csv"},
  "repeat": ["Health spending (% of GDP)", "Life expectancy (years)", "Alcohol (litres per person)"],
  "columns": 3,
  "spec": {
    "width": 200,
    "height": 170,
    "transform": [{"filter": "datum.TIME_PERIOD >= 2015 && datum.TIME_PERIOD <= 2023"},
      {"calculate": "datum['Reference area'] == 'Australia' ? 1 : 0", "as": "is_australia"}],
    "mark": {"type": "line", "point": true, "strokeWidth": 2},
    "encoding": {
      "x": {"field": "TIME_PERIOD", "type": "quantitative", "title": "Year", "scale": {"domain": [2015, 2023]},"axis": {"format": "d", "tickCount": 4}},
      "y": {"field": {"repeat": "repeat"}, "type": "quantitative", "scale": {"zero": false}},
      "detail": {"field": "Reference area", "type": "nominal"},
      "color": {"condition":{"test":"datum['Reference area'] == 'Australia'","value":"#e41a1c"},"value":"#b0bec5"},
      "tooltip": [
        {"field": "Reference area", "type": "nominal", "title": "Country"},
        {"field": "TIME_PERIOD", "type": "quantitative", "title": "Year", "format": "d"},
        {"field": {"repeat": "repeat"}, "type": "quantitative", "format": ".1f"}
      ]
    }
  }
}