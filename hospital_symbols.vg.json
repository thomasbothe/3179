{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "view": {
    "stroke": null
  },
  "title": "Hospitals per 2-degree grid cell",
  "width": 520,
  "height": 330,
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -28
    ],
    "scale": 410,
    "translate": [
      260,
      175
    ]
  },
  "layer": [
    {
      "data": {
        "url": "ne_110m.json",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.ADMIN === 'Australia'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "hospitals.csv"
      },
      "transform": [
        {
          "filter": "isValid(datum.Longitude) && isValid(datum.Latitude)"
        },
        {
          "bin": {
            "step": 2
          },
          "field": "Longitude",
          "as": "lon_bin"
        },
        {
          "bin": {
            "step": 2
          },
          "field": "Latitude",
          "as": "lat_bin"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "hospitals"
            }
          ],
          "groupby": [
            "lon_bin",
            "lon_bin_end",
            "lat_bin",
            "lat_bin_end"
          ]
        },
        {
          "calculate": "datum.lon_bin + 1",
          "as": "lon_mid"
        },
        {
          "calculate": "datum.lat_bin + 1",
          "as": "lat_mid"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.65,
        "color": "#2590c8",
        "stroke": "white"
      },
      "encoding": {
        "longitude": {
          "field": "lon_mid",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat_mid",
          "type": "quantitative"
        },
        "size": {
          "field": "hospitals",
          "type": "quantitative",
          "title": "Hospitals",
          "scale": {
            "type": "threshold",
            "domain": [
              5,
              20,
              50,
              100
            ],
            "range": [
              30,
              150,
              400,
              800,
              1400
            ]
          }
        },
        "tooltip": [
          {
            "field": "hospitals",
            "type": "quantitative",
            "title": "Hospitals in this cell"
          }
        ]
      }
    }
  ]
}