{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "view": {
    "stroke": null
  },
  "title": "Child Deaths Before Age 5 (2024)",
  "width": 520,
  "height": 330,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "ne_110m.json",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "Child_Mortality.csv"
      },
            "transform": [
        {
          "lookup": "Country Name",
          "from": {
            "data": {
              "url": "country_centroids.csv"
            },
            "key": "Country Name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "filter": "isValid(datum.lon) && isValid(datum['2024'])"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.7,
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "order": {
          "field": "2024",
          "type": "quantitative",
          "sort": "descending"
        },
        "size": {
          "field": "2024",
          "type": "quantitative",
          "title": "Deaths per 1,000 births",
          "scale": {
            "domain": [
              0,
              120
            ],
            "range": [
              10,
              600
            ]
          }
        },
        "color": {
          "field": "2024",
          "type": "quantitative",
          "title": "Deaths per 1,000 births",
          "scale": {
            "type": "threshold",
            "domain": [
              5,
              20,
              50,
              80
            ],
            "range": [
              "#fee5d9",
              "#fcae91",
              "#fb6a4a",
              "#de2d26",
              "#a50f15"
            ]
          }
        },
        "tooltip": [
          {
            "field": "Country Name",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "2015",
            "type": "quantitative",
            "title": "2015"
          },
          {
            "field": "2024",
            "type": "quantitative",
            "title": "2024"
          }
        ]
      }
    }
  ]
}
