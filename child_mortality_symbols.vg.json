{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "view": {
    "stroke": null
  },
  "title": "Child Deaths Before Age 5 (2024)",
  "width": 520,
  "height": 330,
  "params": [
    {
        "name": "zoom_level",
        "value": 100,
        "bind": {
            "input": "range",
            "min": 100,
            "max": 400,
            "step": 50,
            "name": "Zoom: "
        }
    },
    {
        "name": "centre_to",
        "value": [0, 0],
        "bind": {
            "input": "select",
            "options": [
                [0, 0],
                [100, 30],
                [20, 0],
                [15, 52],
                [-100, 40],
                [-60, -15],
                [175, -15]
            ],
            "labels": ["World", "Asia", "Africa", "Europe", "North America", "South America", "Oceania"],
            "name": "Map Centre: "
        }
    }
  ],
   "projection": {
    "type": "equalEarth",
    "center": {"expr": "centre_to"},
    "scale": {"expr": "zoom_level"}
  },
  "layer": [
    {
      "data": {
        "url": "ne_110m.json",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "Child_Mortality.csv"
      },
            "transform": [
        {
          "lookup": "Country Name",
          "from": {
            "data": {
              "url": "country_centroids.csv"
            },
            "key": "Country Name",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "filter": "isValid(datum.lon) && isValid(datum.lat) && isValid(datum['2024'])"
        }
      ],
      "mark": {
        "type": "circle",
        "fill": "#e41a1c",
        "opacity": 0.7,
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "order": {
          "field": "2024",
          "type": "quantitative",
          "sort": "descending"
        },
        "size": {
          "field": "2024",
          "type": "quantitative",
          "title": "Deaths per 1,000 births",
          "scale": {
            "domain": [
              0,
              120
            ],
            "range": [
              10,
              200
            ]
          }
        },
        "tooltip": [
          {
            "field": "Country Name",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "2024",
            "type": "quantitative",
            "title": "Deaths per 1,000 births"
          }
        ]
      }
    }
  ]
}
