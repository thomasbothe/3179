{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",
  "title": {
    "text": "Alcohol Consumption per Year"
  },
  "data": {
    "url": "Alcohol_Consumption.csv"
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "aggregate": "mean",
      "field": "OBS_VALUE",
      "type": "quantitative",
      "title": "Alcohol Consumption per Year (litres)"
    },
    "y": {
      "field": "Reference area",
      "type": "nominal",
      "title": "Country"
    },
    "tooltip": [
      {
        "field": "Reference area",
        "type": "nominal",
        "title": "Country"
      },
      {
        "field": "OBS_VALUE",
        "type": "quantitative",
        "title": "Alcohol Consumption per Year (litres)"
      }
    ]
  },
  "width": "container"
}